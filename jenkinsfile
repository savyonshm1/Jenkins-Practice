pipeline{
    agent any
    environment {
       
    }    
    stages{
        stage("build"){
            steps{
                sh 'echo ===== build stage ====='
                sh 'echo some-text > app.txt'
            }
        }
        stage("test"){
            steps{
                sh 'echo ===== test stage ====='
                sh 'if [ -f "app.txt" ]; then
                        echo "The file exists."
                    else
                        echo "The file does not exist."
                    fi'
            }
        }
        stage("deploy"){
            steps{
                sh 'echo ===== deploy stage ====='
                sh 'mkdir deploy && cp app.txt deploy/' 
            }
        }
    }
    post {
        always {
            cleanWs() 
        }
    }
}