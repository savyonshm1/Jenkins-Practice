pipeline{
    agent any
    stages{
        stage("clone the code"){
            steps{
                sh 'echo ===== build stage ====='
            }
        }
        stage("build the code"){
            steps{
                sh 'echo ===== test stage ====='
            }
        }
        stage("test the code"){
            steps{
                sh 'echo ===== deploy stage =====' 
            }
        }
    }
}