pipeline{
    agent any
    environment {
       APP_VERSION = '1.0'
       APP_NAME = 'savyons-app'
       DOCKER_REPO = 'link'
    }    
    stages{
        stage("build"){
            steps{
                sh 'echo ===== build stage ====='
                sh 'echo some-text > app.txt'
                // sh 'printenv'
            }
        }
        stage("test"){
            steps{
                sh 'echo ===== test stage ====='
                sh '''
                    if [ -f "app.txt" ]; then
                            echo "The file exists."
                        else
                            echo "The file does not exist."
                        fi
                '''        
                sh 'the pipeline name is ${JOB_BASE_NAME}' 
                sh 'the pipeline name is ${env.BUILD_NUMBER}'
            }
        }
        stage("deploy"){
            steps{
                sh 'echo ===== deploy stage ====='
                sh 'mkdir deploy && cp app.txt deploy/' 
            }
        }
    }
    post {
        always {
            cleanWs() 
        }
    }
}